{
  "name": "@unislang/unifold-renderer-dom",
  "version": "0.0.0",
  "private": true,
  "description": "Selective Unifold IR renderer for standards-based DOM hosts.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-data.ts",
    "!src/**/test-helpers.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config ../../vitest.config.ts --root ../.. packages/renderer-dom"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unislang/unifold.git",
    "directory": "packages/renderer-dom"
  },
  "homepage": "https://unifold.org",
  "bugs": "https://github.com/unislang/unifold/issues",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@unislang/unifold-catalog": "workspace:*",
    "@unislang/unifold-contracts": "workspace:*",
    "@unislang/unifold-events": "workspace:*",
    "@unislang/unifold-forms": "workspace:*",
    "@unislang/unifold-ir": "workspace:*"
  },
  "devDependencies": {
    "@unislang/unifold-elements": "workspace:*",
    "happy-dom": "^20.0.10",
    "vitest": "^3.2.4"
  }
}
