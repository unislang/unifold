{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unifold.org/ui-module/1.0/schema.json",
  "title": "Unifold UI Module",
  "type": "object",
  "propertyNames": { "$ref": "#/$defs/safePropertyName" },
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "imports", "exports"],
  "properties": {
    "$schema": { "const": "https://schemas.unifold.org/ui-module/1.0/schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/moduleId" },
    "version": { "$ref": "#/$defs/version" },
    "imports": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/import" }
    },
    "exports": { "$ref": "#/$defs/exports" }
  },
  "$defs": {
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compositions", "documents", "resources"],
      "properties": {
        "compositions": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/plainObject" }
        },
        "documents": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "document"],
            "properties": {
              "name": { "$ref": "#/$defs/exportName" },
              "document": { "$ref": "#/$defs/plainObject" }
            }
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/exportName" },
        "kind": {
          "enum": [
            "layout",
            "machine",
            "message",
            "rule",
            "scenario",
            "schema",
            "semantics",
            "token"
          ]
        },
        "value": { "$ref": "#/$defs/jsonValue" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "layout" } }, "required": ["kind"] },
          "then": { "properties": { "value": { "$ref": "#/$defs/layoutDefinition" } } }
        }
      ]
    },
    "layoutDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutType", "version", "variables", "template"],
      "properties": {
        "layoutType": { "$ref": "#/$defs/exportName" },
        "version": { "$ref": "#/$defs/version" },
        "variables": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/layoutVariableDefinition" }
        },
        "template": { "$ref": "#/$defs/layoutNode" }
      }
    },
    "layoutVariableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["array", "boolean", "nodes", "number", "object", "string"] },
        "required": { "type": "boolean" },
        "default": true
      }
    },
    "layoutReference": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\{\\{[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)*\\}\\}$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$var"],
          "properties": { "$var": { "type": "string" } }
        }
      ]
    },
    "layoutNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {
          "oneOf": [{ "$ref": "#/$defs/exportName" }, { "$ref": "#/$defs/layoutReference" }]
        },
        "type": {
          "oneOf": [{ "$ref": "#/$defs/exportName" }, { "$ref": "#/$defs/layoutReference" }]
        },
        "props": { "type": "object" },
        "children": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/layoutNode" } },
            { "$ref": "#/$defs/layoutReference" }
          ]
        },
        "events": {
          "type": "object",
          "propertyNames": { "enum": ["onBlur", "onClick", "onInput", "onReset", "onSubmit"] },
          "additionalProperties": { "$ref": "#/$defs/exportName" }
        },
        "if": {
          "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/layoutReference" }]
        },
        "for": { "type": "string", "maxLength": 512 },
        "key": { "$ref": "#/$defs/exportName" }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "version", "integrity", "namespace"],
      "properties": {
        "moduleId": { "$ref": "#/$defs/moduleId" },
        "version": { "$ref": "#/$defs/version" },
        "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    },
    "moduleId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "exportName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "plainObject": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/safePropertyName" }
    },
    "jsonValue": {
      "oneOf": [
        { "type": ["boolean", "null", "number", "string"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/safePropertyName" },
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "safePropertyName": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|prototype|constructor)$).+$"
    }
  }
}
