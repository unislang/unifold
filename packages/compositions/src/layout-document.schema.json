{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unifold.org/layout-document/1.0/schema.json",
  "title": "Unifold Layout Authoring Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "revision",
    "catalog",
    "layoutType",
    "layoutVersion",
    "variables"
  ],
  "properties": {
    "$schema": { "const": "https://schemas.unifold.org/layout-document/1.0/schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/name" },
    "revision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "catalog": { "type": "object" },
    "layoutType": { "$ref": "#/$defs/name" },
    "layoutVersion": { "$ref": "#/$defs/version" },
    "variables": { "type": "object" },
    "layouts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/layout" }
    },
    "compositionManifest": { "type": "object" },
    "controls": { "$ref": "#/$defs/controlTopology" },
    "machines": { "type": "array" },
    "rules": { "type": "array" },
    "semantics": { "type": "object" },
    "stores": { "type": "array" }
  },
  "$defs": {
    "controlTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "nodes"],
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "nodes": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/controlTopologyNode" }
        }
      }
    },
    "controlTopologyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "key": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["form", "group", "array", "record", "control"] },
        "parentId": { "$ref": "#/$defs/name" }
      }
    },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "reference": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\{\\{[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)*\\}\\}$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$var"],
          "properties": { "$var": { "type": "string" } }
        }
      ]
    },
    "variableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["array", "boolean", "nodes", "number", "object", "string"] },
        "required": { "type": "boolean" },
        "default": true
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutType", "version", "variables", "template"],
      "properties": {
        "layoutType": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/version" },
        "variables": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/variableDefinition" }
        },
        "template": { "$ref": "#/$defs/node" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "emptyFocusTarget": ["collection", "for", "key"]
      },
      "required": ["id", "type"],
      "properties": {
        "id": { "oneOf": [{ "$ref": "#/$defs/name" }, { "$ref": "#/$defs/reference" }] },
        "type": { "oneOf": [{ "$ref": "#/$defs/name" }, { "$ref": "#/$defs/reference" }] },
        "props": { "type": "object" },
        "children": {
          "oneOf": [
            { "type": "array", "items": { "$ref": "#/$defs/node" } },
            { "$ref": "#/$defs/reference" }
          ]
        },
        "events": {
          "type": "object",
          "propertyNames": { "enum": ["onBlur", "onClick", "onInput", "onReset", "onSubmit"] },
          "additionalProperties": { "$ref": "#/$defs/name" }
        },
        "collection": { "$ref": "#/$defs/name" },
        "emptyFocusTarget": { "$ref": "#/$defs/name" },
        "if": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/reference" }] },
        "for": { "type": "string", "maxLength": 512 },
        "key": { "$ref": "#/$defs/name" }
      }
    }
  }
}
