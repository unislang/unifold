{
  "name": "@unislang/unifold-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Governed headless design sessions for AI-assisted Unifold preview, approval, apply, and export.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/studio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unislang/unifold.git",
    "directory": "packages/studio"
  },
  "homepage": "https://unifold.org",
  "bugs": "https://github.com/unislang/unifold/issues",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@unislang/unifold": "workspace:*",
    "@unislang/unifold-ai": "workspace:*",
    "@unislang/unifold-contracts": "workspace:*",
    "@unislang/unifold-devtools": "workspace:*",
    "@unislang/unifold-export": "workspace:*",
    "xstate": "^5.20.2"
  },
  "devDependencies": {
    "happy-dom": "^20.0.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
