{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unifold.org/collaboration/1.0/schema.json",
  "title": "Unifold Collaboration Request",
  "oneOf": [
    { "$ref": "#/$defs/propose" },
    { "$ref": "#/$defs/approve" },
    { "$ref": "#/$defs/comment" },
    { "$ref": "#/$defs/publish" },
    { "$ref": "#/$defs/undo" },
    { "$ref": "#/$defs/presence" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!__proto__$|constructor$|prototype$)[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^/(?:[^~]|~[01])*$"
    },
    "base": {
      "type": "object",
      "required": ["correlationId", "operation", "protocolVersion", "requestId"],
      "properties": {
        "correlationId": { "$ref": "#/$defs/id" },
        "operation": {
          "enum": [
            "proposal.approve",
            "proposal.comment",
            "presence.update",
            "proposal.submit",
            "revision.publish",
            "revision.undo"
          ]
        },
        "protocolVersion": { "const": "1.0.0" },
        "requestId": { "$ref": "#/$defs/id" }
      }
    },
    "patch": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "enum": ["add", "replace", "test"] },
            "path": { "$ref": "#/$defs/pointer" },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "path"],
          "properties": {
            "op": { "const": "remove" },
            "path": { "$ref": "#/$defs/pointer" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["from", "op", "path"],
          "properties": {
            "from": { "$ref": "#/$defs/pointer" },
            "op": { "enum": ["copy", "move"] },
            "path": { "$ref": "#/$defs/pointer" }
          },
          "additionalProperties": false
        }
      ]
    },
    "propose": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": [
            "affectedIds",
            "baseRevision",
            "branchId",
            "idempotencyKey",
            "intent",
            "operations",
            "proposalId"
          ],
          "properties": {
            "operation": { "const": "proposal.submit" },
            "affectedIds": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            },
            "baseRevision": { "$ref": "#/$defs/id" },
            "branchId": { "$ref": "#/$defs/id" },
            "causationId": { "$ref": "#/$defs/id" },
            "idempotencyKey": { "$ref": "#/$defs/id" },
            "intent": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "$ref": "#/$defs/patch" }
            },
            "proposalId": { "$ref": "#/$defs/id" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "approve": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["expectedRevision", "proposalId"],
          "properties": {
            "operation": { "const": "proposal.approve" },
            "expectedRevision": { "$ref": "#/$defs/id" },
            "proposalId": { "$ref": "#/$defs/id" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "comment": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["body", "proposalId"],
          "properties": {
            "operation": { "const": "proposal.comment" },
            "body": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "proposalId": { "$ref": "#/$defs/id" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "publish": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["branchId", "revision"],
          "properties": {
            "operation": { "const": "revision.publish" },
            "branchId": { "$ref": "#/$defs/id" },
            "revision": { "$ref": "#/$defs/id" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "undo": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["branchId", "idempotencyKey", "targetRevision"],
          "properties": {
            "operation": { "const": "revision.undo" },
            "branchId": { "$ref": "#/$defs/id" },
            "idempotencyKey": { "$ref": "#/$defs/id" },
            "targetRevision": { "$ref": "#/$defs/id" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "presence": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["branchId", "draft", "expiresInMs"],
          "properties": {
            "operation": { "const": "presence.update" },
            "branchId": { "$ref": "#/$defs/id" },
            "cursor": { "type": "object", "maxProperties": 64 },
            "draft": { "type": "boolean" },
            "expiresInMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
            "selectedId": { "$ref": "#/$defs/id" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
