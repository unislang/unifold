{
  "name": "@unislang/unifold",
  "version": "0.0.0",
  "private": true,
  "description": "Supported Unifold application bootstrap and document coordinator.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-data.ts",
    "!src/**/test-helpers.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./breadcrumb": {
      "types": "./dist/breadcrumb.d.ts",
      "import": "./dist/breadcrumb.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./file-input": {
      "types": "./dist/file-input.d.ts",
      "import": "./dist/file-input.js"
    },
    "./form-structure": {
      "types": "./dist/form-structure.d.ts",
      "import": "./dist/form-structure.js"
    },
    "./content-media": {
      "types": "./dist/content-media.d.ts",
      "import": "./dist/content-media.js"
    },
    "./audit-log": {
      "types": "./dist/audit-log.d.ts",
      "import": "./dist/audit-log.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid.d.ts",
      "import": "./dist/data-grid.js"
    },
    "./search-results": {
      "types": "./dist/search-results.d.ts",
      "import": "./dist/search-results.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "import": "./dist/combobox.js"
    },
    "./stepper": {
      "types": "./dist/stepper.d.ts",
      "import": "./dist/stepper.js"
    },
    "./menu-button": {
      "types": "./dist/menu-button.d.ts",
      "import": "./dist/menu-button.js"
    },
    "./master-detail": {
      "types": "./dist/master-detail.d.ts",
      "import": "./dist/master-detail.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./wizard": {
      "types": "./dist/wizard.d.ts",
      "import": "./dist/wizard.js"
    },
    "./virtual-list": {
      "types": "./dist/virtual-list.d.ts",
      "import": "./dist/virtual-list.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/unifold"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unislang/unifold.git",
    "directory": "packages/unifold"
  },
  "homepage": "https://unifold.org",
  "bugs": "https://github.com/unislang/unifold/issues",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sagold/json-pointer": "7.2.1",
    "@unislang/unifold-compositions": "workspace:*",
    "@unislang/unifold-catalog": "workspace:*",
    "@unislang/unifold-contracts": "workspace:*",
    "@unislang/unifold-data": "workspace:*",
    "@unislang/unifold-elements": "workspace:*",
    "@unislang/unifold-events": "workspace:*",
    "@unislang/unifold-ir": "workspace:*",
    "@unislang/unifold-renderer-dom": "workspace:*",
    "@unislang/unifold-runtime": "workspace:*",
    "@unislang/unifold-semantics": "workspace:*",
    "@unislang/unifold-xstate": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "happy-dom": "^20.0.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
