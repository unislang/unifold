{
  "name": "@unislang/unifold-elements",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, explicitly registered Unifold Web Components.",
  "type": "module",
  "sideEffects": false,
  "customElements": "./dist/custom-elements.json",
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-data.ts",
    "!src/**/test-helpers.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip-entry.d.ts",
      "import": "./dist/tooltip-entry.js"
    },
    "./popover": {
      "types": "./dist/popover-entry.d.ts",
      "import": "./dist/popover-entry.js"
    },
    "./breadcrumb": {
      "types": "./dist/breadcrumb-entry.d.ts",
      "import": "./dist/breadcrumb-entry.js"
    },
    "./dialog": {
      "types": "./dist/dialog-entry.d.ts",
      "import": "./dist/dialog-entry.js"
    },
    "./file-input": {
      "types": "./dist/file-input-entry.d.ts",
      "import": "./dist/file-input-entry.js"
    },
    "./form-structure": {
      "types": "./dist/form-structure-entry.d.ts",
      "import": "./dist/form-structure-entry.js"
    },
    "./content-media": {
      "types": "./dist/content-media-entry.d.ts",
      "import": "./dist/content-media-entry.js"
    },
    "./audit-log": {
      "types": "./dist/audit-log-entry.d.ts",
      "import": "./dist/audit-log-entry.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid-entry.d.ts",
      "import": "./dist/data-grid-entry.js"
    },
    "./search-results": {
      "types": "./dist/search-results-entry.d.ts",
      "import": "./dist/search-results-entry.js"
    },
    "./combobox": {
      "types": "./dist/combobox-entry.d.ts",
      "import": "./dist/combobox-entry.js"
    },
    "./stepper": {
      "types": "./dist/stepper-entry.d.ts",
      "import": "./dist/stepper-entry.js"
    },
    "./menu-button": {
      "types": "./dist/menu-button-entry.d.ts",
      "import": "./dist/menu-button-entry.js"
    },
    "./master-detail": {
      "types": "./dist/master-detail-entry.d.ts",
      "import": "./dist/master-detail-entry.js"
    },
    "./tabs": {
      "types": "./dist/tabs-entry.d.ts",
      "import": "./dist/tabs-entry.js"
    },
    "./wizard": {
      "types": "./dist/wizard-entry.d.ts",
      "import": "./dist/wizard-entry.js"
    },
    "./virtual-list": {
      "types": "./dist/virtual-list-entry.d.ts",
      "import": "./dist/virtual-list-entry.js"
    },
    "./component-definitions.json": "./dist/component-definitions.json",
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "scripts": {
    "build": "tsc -b && pnpm generate:cem",
    "generate:cem": "node scripts/generate-cem.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/elements && node --test scripts/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unislang/unifold.git",
    "directory": "packages/elements"
  },
  "homepage": "https://unifold.org",
  "bugs": "https://github.com/unislang/unifold/issues",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lucide/icons": "1.34.0",
    "@unislang/unifold-catalog": "workspace:*",
    "@unislang/unifold-contracts": "workspace:*",
    "@unislang/unifold-events": "workspace:*",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "ajv": "8.20.0",
    "custom-elements-manifest": "2.1.0",
    "happy-dom": "^20.0.10",
    "vitest": "^3.2.4"
  }
}
