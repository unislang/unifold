{
  "name": "@unislang/unifold-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic validation and starter generation through public Unifold contracts.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "bin": {
    "unifold": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/cli"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unislang/unifold.git",
    "directory": "packages/cli"
  },
  "homepage": "https://unifold.org",
  "bugs": "https://github.com/unislang/unifold/issues",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@unislang/unifold": "workspace:*",
    "@unislang/unifold-modules": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
