{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unifold.org/ui-module-project/1.0/schema.json",
  "title": "Unifold UI Module Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entry", "sources"],
  "properties": {
    "$schema": {
      "const": "https://schemas.unifold.org/ui-module-project/1.0/schema.json"
    },
    "schemaVersion": { "const": "1.0.0" },
    "entry": { "$ref": "#/$defs/entry" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourcePath" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "version", "exportName"],
      "properties": {
        "moduleId": { "$ref": "#/$defs/moduleId" },
        "version": { "$ref": "#/$defs/version" },
        "exportName": { "$ref": "#/$defs/exportName" }
      }
    },
    "moduleId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "exportName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    }
  }
}
