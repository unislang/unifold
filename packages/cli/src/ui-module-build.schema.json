{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unifold.org/ui-module-build/2.0/schema.json",
  "title": "Unifold UI Module Build Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entry", "irIntegrity", "resolvedArtifact"],
  "properties": {
    "$schema": { "const": "https://schemas.unifold.org/ui-module-build/2.0/schema.json" },
    "schemaVersion": { "const": "2.0.0" },
    "entry": { "$ref": "#/$defs/entry" },
    "irIntegrity": { "$ref": "#/$defs/integrity" },
    "resolvedArtifact": { "$ref": "#/$defs/resolvedArtifact" }
  },
  "$defs": {
    "resolvedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoredDocument",
        "composedDocument",
        "document",
        "graph",
        "integrity",
        "layoutDefinitions",
        "resources",
        "sourceMap"
      ],
      "properties": {
        "authoredDocument": { "$ref": "#/$defs/jsonObject" },
        "composedDocument": { "$ref": "#/$defs/jsonObject" },
        "document": { "$ref": "#/$defs/jsonObject" },
        "graph": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/graphEntry" }
        },
        "integrity": { "$ref": "#/$defs/integrity" },
        "layoutDefinitions": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/jsonObject" }
        },
        "resources": {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": { "$ref": "#/$defs/safePropertyName" },
          "additionalProperties": { "$ref": "#/$defs/resource" }
        },
        "sourceMap": {
          "type": "object",
          "maxProperties": 32768,
          "propertyNames": { "$ref": "#/$defs/safePropertyName" },
          "additionalProperties": { "$ref": "#/$defs/sourceLocation" }
        }
      }
    },
    "graphEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity", "moduleId", "namespace", "sourceId", "version"],
      "properties": {
        "integrity": { "$ref": "#/$defs/integrity" },
        "moduleId": { "$ref": "#/$defs/moduleId" },
        "namespace": { "type": "string", "maxLength": 128 },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "version", "exportName"],
      "properties": {
        "moduleId": { "$ref": "#/$defs/moduleId" },
        "version": { "$ref": "#/$defs/version" },
        "exportName": { "$ref": "#/$defs/exportName" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/resourceId" },
        "kind": {
          "enum": [
            "layout",
            "machine",
            "message",
            "rule",
            "scenario",
            "schema",
            "semantics",
            "token"
          ]
        },
        "value": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "version", "sourceId", "pointer"],
      "properties": {
        "moduleId": { "$ref": "#/$defs/moduleId" },
        "version": { "$ref": "#/$defs/version" },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "pointer": { "type": "string", "maxLength": 4096 }
      }
    },
    "moduleId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "exportName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!(?:__proto__|prototype|constructor)$).+$"
    },
    "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9_-]{43}$" },
    "jsonObject": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/safePropertyName" },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "null" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "safePropertyName": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|prototype|constructor)$).+$"
    }
  }
}
