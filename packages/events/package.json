{
  "name": "@unislang/unifold-events",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical event, node, transaction, and command contracts for Unifold.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schemas",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-data.ts",
    "!src/**/test-helpers.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/effect-event-data.schema.json": "./schemas/effect-event-data.schema.json"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/events"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unislang/unifold.git",
    "directory": "packages/events"
  },
  "homepage": "https://github.com/unislang/unifold#readme",
  "bugs": "https://github.com/unislang/unifold/issues",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@unislang/unifold-contracts": "workspace:*"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
