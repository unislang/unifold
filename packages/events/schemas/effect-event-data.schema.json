{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unifold.org/events/effect-data/1.0/schema.json",
  "title": "Unifold Effect Event Data",
  "type": "object",
  "required": ["phase", "change", "runtime"],
  "properties": {
    "phase": { "const": "effect" },
    "change": { "$ref": "#/$defs/change" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "sourceNode": { "$ref": "#/$defs/sourceNode" },
    "snapshot": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "boundedId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "change": {
      "type": "object",
      "required": ["commandType"],
      "properties": {
        "commandType": {
          "enum": [
            "announcement.request",
            "effect.invoke",
            "focus.request",
            "navigation.request",
            "store.write"
          ]
        },
        "targetId": { "$ref": "#/$defs/boundedId" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["documentId"],
      "properties": {
        "documentId": { "$ref": "#/$defs/boundedId" },
        "documentRevision": { "$ref": "#/$defs/boundedId" },
        "locale": { "type": "string", "minLength": 1, "maxLength": 128 },
        "surfaceId": { "$ref": "#/$defs/boundedId" }
      },
      "additionalProperties": false
    },
    "disclosure": {
      "type": "object",
      "required": ["classification", "mode", "snapshotRevision"],
      "properties": {
        "classification": {
          "enum": ["public", "internal", "confidential", "restricted", "never-export"]
        },
        "mode": { "enum": ["full", "metadata-only"] },
        "reason": { "enum": ["classification", "store-write"] },
        "snapshotRevision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sourceNode": {
      "type": "object",
      "required": ["id", "instanceId", "kind", "scopePath", "type", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/boundedId" },
        "instanceId": { "$ref": "#/$defs/boundedId" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "parentId": { "$ref": "#/$defs/boundedId" },
        "scopePath": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/boundedId" }
        },
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    }
  }
}
