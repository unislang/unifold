{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unifold.org/semantic-graph/1.0/schema.json",
  "title": "Unifold Semantic Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "vocabulary", "publication", "entities"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "primaryEntity": { "type": "string", "minLength": 1 },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "release"],
      "properties": {
        "uri": { "const": "https://schema.org" },
        "release": { "enum": ["30.0"] }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "profile"],
      "properties": {
        "mode": { "enum": ["public-page"] },
        "profile": { "enum": ["schema.org"] }
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "properties"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "constant" },
            "value": { "type": ["boolean", "null", "number", "string"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entityId"],
          "properties": {
            "kind": { "const": "entity-reference" },
            "entityId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeId"],
          "properties": {
            "kind": { "const": "node-control-value" },
            "nodeId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "instanceId", "exportName"],
          "properties": {
            "kind": { "const": "composition-export-control-value" },
            "instanceId": { "type": "string", "minLength": 1 },
            "exportName": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "items"],
          "properties": {
            "kind": { "const": "list" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/value" } }
          }
        }
      ]
    }
  }
}
