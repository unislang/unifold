{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unifold.org/collection-behavior/1.0/schema.json",
  "title": "Unifold Collection Behavior",
  "type": "object",
  "required": ["contractVersion", "nodes"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["collectionId", "emptyFocusTargetId"],
        "properties": {
          "collectionId": { "type": "string", "minLength": 1 },
          "emptyFocusTargetId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
