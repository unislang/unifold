{
  "name": "@unislang/unifold-hierarchical-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build --minify terser",
    "build:e2e": "tsc -b && vite build --mode e2e --minify terser",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4183",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@unislang/unifold": "workspace:*",
    "@unislang/unifold-events": "workspace:*",
    "@unislang/unifold-theme": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.0.10",
    "terser": "5.16.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
