{
  "$schema": "https://schemas.unifold.org/ui-module/1.0/schema.json",
  "schemaVersion": "1.0.0",
  "id": "org.unifold.examples.hierarchical-application",
  "version": "1.0.0",
  "imports": [
    {
      "moduleId": "org.unifold.examples.hierarchical-layouts",
      "version": "1.0.0",
      "integrity": "sha256-zUJUJzB-4FqZ8Y14WS1-4jfnyDO7SISCr3WZ09d7ahw",
      "namespace": "layouts"
    }
  ],
  "exports": {
    "compositions": [],
    "documents": [
      {
        "name": "application",
        "document": {
          "$schema": "https://schemas.unifold.org/layout-document/1.0/schema.json",
          "schemaVersion": "1.0.0",
          "id": "hierarchical-contact-example",
          "revision": "1",
          "catalog": { "name": "unifold-core", "version": "1.0.0" },
          "layoutType": "layouts/layout/contact-workflow",
          "layoutVersion": "1.0.0",
          "variables": {
            "heading": "Tell us about yourself",
            "description": "Every interaction enters one observable event stream.",
            "fields": [
              {
                "id": "contact-name",
                "type": "TextField",
                "props": {
                  "label": "Your name",
                  "name": "name",
                  "required": true
                }
              },
              {
                "id": "contact-consent",
                "type": "Checkbox",
                "props": {
                  "label": "I agree to create the summary",
                  "name": "consent"
                }
              },
              {
                "id": "contact-notifications",
                "type": "Switch",
                "props": {
                  "label": "Enable notifications",
                  "name": "notifications",
                  "required": true,
                  "value": true
                },
                "events": { "onInput": "NOTIFICATIONS_CHANGED" }
              },
              {
                "id": "locked-notifications",
                "type": "Switch",
                "props": {
                  "disabled": true,
                  "label": "Locked notifications",
                  "name": "lockedNotifications"
                }
              },
              {
                "id": "contact-age",
                "type": "NumberField",
                "props": {
                  "label": "Age",
                  "name": "age",
                  "min": 0,
                  "max": 130,
                  "step": 1
                },
                "events": { "onInput": "AGE_CHANGED" }
              },
              {
                "id": "contact-start-date",
                "type": "DateField",
                "props": {
                  "autocomplete": "off",
                  "label": "Start date",
                  "max": "2027-12-31",
                  "min": "2025-01-01",
                  "name": "startDate",
                  "required": true,
                  "step": 1,
                  "value": "2026-08-26"
                },
                "events": { "onInput": "START_DATE_CHANGED" }
              },
              {
                "id": "locked-start-date",
                "type": "DateField",
                "props": {
                  "disabled": true,
                  "label": "Locked start date",
                  "name": "lockedStartDate"
                }
              },
              {
                "id": "profile-search",
                "type": "SearchField",
                "props": {
                  "autocomplete": "off",
                  "label": "Search profiles",
                  "name": "profileSearch",
                  "placeholder": "Name or email"
                },
                "events": { "onInput": "SEARCH_CHANGED" }
              },
              {
                "id": "contact-topics",
                "type": "CheckboxGroup",
                "props": {
                  "label": "Topics",
                  "name": "topics",
                  "options": [
                    { "label": "Product news", "value": "news" },
                    { "label": "Security alerts", "value": "security" },
                    { "disabled": true, "label": "Internal updates", "value": "internal" }
                  ],
                  "required": true,
                  "value": ["news"]
                },
                "events": { "onInput": "TOPICS_CHANGED" }
              },
              {
                "id": "contact-actions",
                "type": "Stack",
                "props": { "direction": "horizontal", "gap": "sm" },
                "children": [
                  {
                    "id": "show-summary",
                    "type": "Button",
                    "props": { "label": "Create summary" },
                    "events": { "onClick": "SHOW_SUMMARY" }
                  },
                  {
                    "id": "submit-contact",
                    "type": "Button",
                    "props": {
                      "action": "submit",
                      "label": "Submit contact details"
                    }
                  },
                  {
                    "id": "summary-status",
                    "type": "Text",
                    "props": { "content": "Summary not created" }
                  }
                ]
              },
              {
                "id": "profile-ready-toast",
                "type": "Toast",
                "props": {
                  "dismissible": true,
                  "dismissLabel": "Dismiss profile notification",
                  "label": "Profile ready",
                  "message": "Your profile changes are ready to review.",
                  "status": "success",
                  "variant": "subtle"
                },
                "events": { "onClick": "TOAST_DISMISSED" }
              },
              {
                "id": "security-warning-toast",
                "type": "Toast",
                "props": {
                  "dismissible": false,
                  "label": "Security warning",
                  "message": "This important notification requires review.",
                  "status": "warning",
                  "variant": "solid"
                }
              },
              {
                "id": "results-pagination",
                "type": "Pagination",
                "props": {
                  "items": [
                    {
                      "accessibleLabel": "Previous results page",
                      "disabled": true,
                      "id": "previous",
                      "kind": "previous",
                      "label": "Previous"
                    },
                    {
                      "accessibleLabel": "Current results page, page 1",
                      "current": true,
                      "href": "#results-page-1",
                      "id": "results-page-1",
                      "kind": "page",
                      "label": "1"
                    },
                    {
                      "accessibleLabel": "Go to results page 2",
                      "href": "#results-page-2",
                      "id": "results-page-2",
                      "kind": "page",
                      "label": "2"
                    },
                    {
                      "accessibleLabel": "More result pages",
                      "id": "more-results",
                      "kind": "overflow",
                      "label": "…"
                    },
                    {
                      "accessibleLabel": "Next results page",
                      "href": "#results-page-2",
                      "id": "next",
                      "kind": "next",
                      "label": "Next"
                    }
                  ],
                  "label": "Search result pages"
                },
                "events": { "onClick": "RESULTS_PAGE_CHANGED" }
              },
              {
                "id": "profile-card",
                "type": "Card",
                "props": {
                  "label": "Profile media summary",
                  "padding": "lg",
                  "surface": "subtle"
                },
                "children": [
                  {
                    "id": "profile-image",
                    "type": "Image",
                    "props": {
                      "alt": "Blue and green geometric profile placeholder",
                      "fit": "contain",
                      "height": 180,
                      "loading": "lazy",
                      "src": "/profile-placeholder.svg",
                      "width": 320
                    }
                  },
                  {
                    "id": "profile-card-copy",
                    "type": "Text",
                    "props": {
                      "content": "This card is authored entirely through nested layout JSON."
                    }
                  }
                ]
              },
              {
                "id": "account-review-dialog",
                "type": "Dialog",
                "props": {
                  "dialogLabel": "Review generated account summary",
                  "dismissLabel": "Cancel summary review",
                  "label": "Review generated summary"
                },
                "children": [
                  {
                    "id": "account-review-copy",
                    "type": "Text",
                    "props": {
                      "content": "This modal is authored through layoutType variables and nested JSON."
                    }
                  },
                  {
                    "id": "account-review-link",
                    "type": "Link",
                    "props": {
                      "href": "#hierarchical-dialog-details",
                      "label": "Inspect generated summary details",
                      "target": "_self"
                    }
                  }
                ]
              }
            ]
          },
          "machines": [
            {
              "schemaVersion": "1.0.0",
              "id": "contact-workflow",
              "version": "1.0.0",
              "ownerId": "contact-form",
              "initial": "editing",
              "states": {
                "editing": {
                  "on": {
                    "TOAST_DISMISSED": {
                      "target": "editing",
                      "commands": ["dismiss-ready-toast", "focus-submit-action"]
                    },
                    "RESULTS_PAGE_CHANGED": {
                      "target": "editing",
                      "commands": ["show-results-page-two"]
                    },
                    "SHOW_SUMMARY": {
                      "target": "summarized",
                      "guard": "consent-granted",
                      "commands": ["show-summary-created"]
                    }
                  }
                },
                "summarized": {}
              }
            }
          ],
          "rules": [
            {
              "schemaVersion": "1.0.0",
              "id": "require-consent",
              "version": "1.0.0",
              "inputs": [
                { "name": "consent", "nodeId": "contact-consent", "pointer": "/control/value" }
              ],
              "expression": { "!": [{ "var": "consent" }] },
              "output": {
                "kind": "node-patch-property",
                "nodeId": "show-summary",
                "property": "disabled"
              }
            }
          ],
          "semantics": {
            "contractVersion": "1.0.0",
            "vocabulary": { "uri": "https://schema.org", "release": "30.0" },
            "primaryEntity": "urn:unifold:example:person",
            "entities": [
              {
                "id": "urn:unifold:example:person",
                "type": "Person",
                "properties": {
                  "name": { "kind": "node-control-value", "nodeId": "contact-name" }
                }
              }
            ],
            "publication": { "mode": "public-page", "profile": "schema.org" }
          }
        }
      }
    ],
    "resources": []
  }
}
