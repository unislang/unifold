{
  "$schema": "https://schemas.unifold.org/ui-document/1.0/schema.json",
  "schemaVersion": "1.0.0",
  "id": "static-export-reference",
  "revision": "revision-1",
  "jsonUiProfile": {
    "name": "unifold-jsonui",
    "version": "1.0.0",
    "upstream": "5401b3d4900ca3032c108d6db00e8a819f4b28e9"
  },
  "catalog": { "name": "unifold-core", "version": "1.0.0" },
  "compositions": [],
  "semantics": {
    "contractVersion": "1.0.0",
    "vocabulary": { "uri": "https://schema.org", "release": "30.0" },
    "primaryEntity": "urn:unifold:person:current",
    "entities": [
      {
        "id": "urn:unifold:person:current",
        "type": "Person",
        "properties": {
          "name": { "kind": "node-control-value", "nodeId": "name" }
        }
      }
    ],
    "publication": { "mode": "public-page", "profile": "schema.org" }
  },
  "view": {
    "$comp": "Composition",
    "id": "root",
    "label": "Static export reference",
    "$children": [
      {
        "$comp": "Heading",
        "id": "heading",
        "content": "Static profile",
        "level": "1"
      },
      {
        "$comp": "Card",
        "id": "profile-card",
        "label": "Profile media summary",
        "padding": "lg",
        "surface": "subtle",
        "$children": [
          {
            "$comp": "Image",
            "alt": "Blue and green geometric profile placeholder",
            "fit": "contain",
            "height": 180,
            "id": "profile-image",
            "loading": "lazy",
            "src": "/profile-placeholder.svg",
            "width": 320
          },
          {
            "$comp": "Text",
            "content": "This card remains visible without JavaScript.",
            "id": "profile-card-copy"
          }
        ]
      },
      {
        "$comp": "Breadcrumb",
        "id": "profile-breadcrumb",
        "items": [
          { "href": "#static-home", "id": "home", "label": "Home" },
          { "href": "#static-accounts", "id": "accounts", "label": "Accounts" },
          { "id": "profile", "label": "Static profile" }
        ],
        "label": "Static profile breadcrumb"
      },
      {
        "$comp": "MenuButton",
        "id": "account-actions",
        "items": [
          { "label": "Edit account", "value": "edit" },
          { "disabled": true, "label": "Delete account", "value": "delete" },
          { "label": "Archive account", "value": "archive" }
        ],
        "label": "Account actions"
      },
      {
        "$comp": "Tooltip",
        "content": "Account actions apply to the current profile.",
        "id": "account-actions-help",
        "label": "About account actions",
        "placement": "bottom"
      },
      {
        "$comp": "Popover",
        "id": "account-summary-popover",
        "label": "Review static account summary",
        "panelLabel": "Static account summary",
        "placement": "bottom",
        "$children": [
          {
            "$comp": "Text",
            "content": "The static account is active.",
            "id": "account-summary-copy"
          },
          {
            "$comp": "Link",
            "href": "#static-account-details",
            "id": "account-summary-link",
            "label": "Open static account documentation",
            "target": "_self"
          }
        ]
      },
      {
        "$comp": "Dialog",
        "id": "account-review-dialog",
        "dialogLabel": "Static account review",
        "dismissLabel": "Cancel static review",
        "label": "Review static account change",
        "$children": [
          {
            "$comp": "Text",
            "content": "Confirm the static account details before continuing.",
            "id": "account-review-copy"
          },
          {
            "$comp": "Link",
            "href": "#static-dialog-details",
            "id": "account-review-link",
            "label": "Inspect static account documentation",
            "target": "_self"
          }
        ]
      },
      {
        "$comp": "Form",
        "id": "form",
        "label": "Profile",
        "$children": [
          {
            "$comp": "TextField",
            "id": "name",
            "inputType": "text",
            "label": "Name",
            "name": "name",
            "required": true,
            "value": "Ada Lovelace"
          },
          {
            "$comp": "NumberField",
            "id": "age",
            "label": "Age",
            "max": 130,
            "min": 0,
            "name": "age",
            "step": 1,
            "value": 40
          },
          {
            "$comp": "SearchField",
            "autocomplete": "off",
            "id": "profile-search",
            "label": "Search profiles",
            "name": "profileSearch",
            "placeholder": "Name or email",
            "value": "Ada"
          },
          {
            "$comp": "Checkbox",
            "id": "newsletter",
            "label": "Receive product updates",
            "name": "newsletter",
            "value": false
          },
          {
            "$comp": "MultiSelect",
            "id": "skills",
            "label": "Skills",
            "name": "skills",
            "options": [
              { "label": "TypeScript", "value": "ts" },
              { "label": "Accessibility", "value": "a11y" },
              { "disabled": true, "label": "Unavailable", "value": "disabled" }
            ],
            "value": ["ts"]
          },
          {
            "$comp": "FileInput",
            "accept": ".pdf,application/pdf",
            "id": "attachments",
            "label": "Attachments",
            "maximumFileBytes": 10485760,
            "multiple": true,
            "name": "attachments",
            "value": []
          },
          {
            "$comp": "Button",
            "id": "save",
            "action": "submit",
            "label": "Save profile"
          }
        ]
      }
    ]
  }
}
