{
  "name": "@unislang/unifold-reference",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-modules.mjs && tsc -b && vite build --minify terser && node scripts/check-bundle-size.mjs",
    "build:e2e": "node scripts/check-modules.mjs && tsc -b && vite build --mode e2e --minify terser",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@unislang/unifold": "workspace:*",
    "@unislang/unifold-contracts": "workspace:*",
    "@unislang/unifold-events": "workspace:*",
    "@unislang/unifold-forms": "workspace:*",
    "@unislang/unifold-modules": "workspace:*",
    "@unislang/unifold-theme": "workspace:*"
  },
  "devDependencies": {
    "@unislang/unifold-cli": "workspace:*",
    "terser": "5.16.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
