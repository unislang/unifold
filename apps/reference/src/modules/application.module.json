{
  "$schema": "https://schemas.unifold.org/ui-module/1.0/schema.json",
  "schemaVersion": "1.0.0",
  "id": "org.unifold.reference.application",
  "version": "1.0.0",
  "imports": [
    {
      "moduleId": "org.unifold.reference.profile",
      "version": "1.0.0",
      "integrity": "sha256-YqH8tn_K_hGGNGPTe8RUDVkGjyImF7p6C5zDWmDoaVo",
      "namespace": "profile"
    }
  ],
  "exports": {
    "compositions": [],
    "documents": [
      {
        "name": "application",
        "document": {
          "$schema": "https://schemas.unifold.org/ui-document/1.0/schema.json",
          "schemaVersion": "1.0.0",
          "id": "profile-reference",
          "revision": "revision-1",
          "jsonUiProfile": {
            "name": "unifold-jsonui",
            "version": "1.0.0",
            "upstream": "5401b3d4900ca3032c108d6db00e8a819f4b28e9"
          },
          "catalog": {
            "name": "unifold-core",
            "version": "1.0.0"
          },
          "machines": [
            {
              "schemaVersion": "1.0.0",
              "id": "profile-workflow",
              "version": "1.0.0",
              "ownerId": "profile-editor",
              "initial": "editing",
              "states": {
                "editing": {
                  "on": {
                    "org.unifold.ui.form.submitted.v1": {
                      "target": "submitted",
                      "commands": ["show-submitted"]
                    }
                  }
                },
                "submitted": {
                  "on": {
                    "org.unifold.ui.control.input.v1": {
                      "target": "editing",
                      "commands": ["show-editing"]
                    },
                    "org.unifold.ui.form.reset.v1": {
                      "target": "editing",
                      "commands": ["show-editing"]
                    }
                  }
                }
              }
            }
          ],
          "semantics": {
            "contractVersion": "1.0.0",
            "vocabulary": {
              "uri": "https://schema.org",
              "release": "30.0"
            },
            "primaryEntity": "urn:unifold:person:current",
            "entities": [
              {
                "id": "urn:unifold:person:current",
                "type": "Person",
                "properties": {
                  "name": {
                    "kind": "composition-export-control-value",
                    "instanceId": "profile-editor",
                    "exportName": "name"
                  }
                }
              }
            ],
            "publication": {
              "mode": "public-page",
              "profile": "schema.org"
            }
          },
          "view": {
            "$compose": "profile/ProfileEditor",
            "$version": "1.0.0",
            "id": "profile-editor",
            "parameters": {
              "fieldLabel": "Your name"
            },
            "slots": {
              "actions": [
                {
                  "$comp": "Button",
                  "id": "submit",
                  "action": "submit",
                  "label": "Create greeting",
                  "testId": "submit"
                },
                {
                  "$comp": "Button",
                  "id": "reset",
                  "action": "reset",
                  "label": "Reset profile",
                  "testId": "reset",
                  "variant": "secondary"
                }
              ]
            }
          }
        }
      }
    ],
    "resources": []
  }
}
