{
  "$schema": "https://schemas.unifold.org/ui-document/1.0/schema.json",
  "schemaVersion": "1.0.0",
  "id": "profile-reference",
  "revision": "revision-1",
  "jsonUiProfile": {
    "name": "unifold-jsonui",
    "version": "1.0.0",
    "upstream": "5401b3d4900ca3032c108d6db00e8a819f4b28e9"
  },
  "catalog": { "name": "unifold-core", "version": "1.0.0" },
  "machines": [
    {
      "schemaVersion": "1.0.0",
      "id": "profile-workflow",
      "version": "1.0.0",
      "ownerId": "profile-editor",
      "initial": "editing",
      "states": {
        "editing": {
          "on": {
            "org.unifold.ui.form.submitted.v1": {
              "target": "submitted",
              "commands": ["show-submitted"]
            }
          }
        },
        "submitted": {
          "on": {
            "org.unifold.ui.control.input.v1": {
              "target": "editing",
              "commands": ["show-editing"]
            },
            "org.unifold.ui.form.reset.v1": {
              "target": "editing",
              "commands": ["show-editing"]
            }
          }
        }
      }
    }
  ],
  "compositions": [
    {
      "contractVersion": "1.0.0",
      "name": "ProfileEditor",
      "version": "1.0.0",
      "parameters": {
        "fieldLabel": { "type": "string", "required": true }
      },
      "slots": [{ "name": "actions", "required": true, "multiple": true }],
      "template": {
        "$comp": "Composition",
        "id": "root",
        "label": "Profile editor",
        "$children": [
          {
            "$comp": "Form",
            "id": "form",
            "label": "Profile",
            "validators": ["names-match"],
            "$children": [
              {
                "$comp": "TextField",
                "id": "name",
                "asyncValidators": ["name-available"],
                "label": { "$parameter": "fieldLabel" },
                "name": "name",
                "required": true,
                "testId": "name",
                "value": ""
              },
              {
                "$comp": "TextField",
                "id": "confirm-name",
                "label": "Confirm name",
                "name": "confirmName",
                "testId": "confirm-name",
                "value": ""
              },
              {
                "$comp": "TextArea",
                "id": "biography",
                "label": "Biography",
                "name": "biography",
                "placeholder": "Share a short biography",
                "rows": 4,
                "testId": "biography",
                "value": ""
              },
              {
                "$comp": "Checkbox",
                "id": "newsletter",
                "label": "Receive product updates",
                "name": "newsletter",
                "testId": "newsletter",
                "value": false
              },
              {
                "$comp": "RadioGroup",
                "id": "contact-preference",
                "label": "Contact preference",
                "name": "contactPreference",
                "options": [
                  { "label": "Email", "value": "email" },
                  { "label": "Phone", "value": "phone" }
                ],
                "testId": "contact-preference",
                "value": "email"
              },
              {
                "$comp": "Select",
                "id": "country",
                "label": "Country",
                "name": "country",
                "options": [
                  { "label": "United States", "value": "us" },
                  { "label": "Canada", "value": "ca" },
                  { "label": "Mexico", "value": "mx" }
                ],
                "testId": "country",
                "value": "us"
              },
              {
                "$comp": "Combobox",
                "id": "assignee",
                "label": "Assignee",
                "name": "assignee",
                "noResultsMessage": "No matching people",
                "options": [
                  { "label": "Ada Lovelace", "value": "ada" },
                  { "disabled": true, "label": "Unavailable person", "value": "unavailable" },
                  { "label": "Grace Hopper", "value": "grace" },
                  { "label": "Katherine Johnson", "value": "katherine" }
                ],
                "placeholder": "Choose a person",
                "testId": "assignee",
                "value": "ada"
              },
              {
                "$comp": "MultiSelect",
                "id": "skills",
                "label": "Skills",
                "name": "skills",
                "options": [
                  { "label": "TypeScript", "value": "ts" },
                  { "label": "Accessibility", "value": "a11y" },
                  { "label": "State machines", "value": "state" }
                ],
                "testId": "skills",
                "value": ["ts"]
              },
              {
                "$comp": "TextField",
                "disabled": true,
                "id": "internal-note",
                "label": "Internal note",
                "name": "internalNote",
                "value": "not-submitted"
              },
              { "$slot": "actions" }
            ]
          },
          {
            "$comp": "Accordion",
            "id": "help",
            "label": "Help and support",
            "name": "helpExpanded",
            "testId": "help",
            "value": false,
            "$children": [
              {
                "$comp": "Box",
                "id": "help-box",
                "label": "Support resources",
                "padding": "lg",
                "surface": "subtle",
                "$children": [
                  {
                    "$comp": "Stack",
                    "id": "help-stack",
                    "$children": [
                      {
                        "$comp": "Icon",
                        "id": "support-icon",
                        "label": "Support information",
                        "name": "info",
                        "size": "lg",
                        "tone": "primary"
                      },
                      {
                        "$comp": "Heading",
                        "id": "support-heading",
                        "content": "Support resources",
                        "level": "3"
                      },
                      {
                        "$comp": "Text",
                        "id": "support-copy",
                        "content": "Choose a support path or review the framework documentation.",
                        "tone": "muted"
                      },
                      {
                        "$comp": "Alert",
                        "id": "support-alert",
                        "content": "Support requests include the current document revision.",
                        "title": "Context preserved"
                      },
                      {
                        "$comp": "Link",
                        "id": "support-link",
                        "href": "#support-resources",
                        "label": "Framework documentation",
                        "target": "_self"
                      },
                      {
                        "$comp": "Grid",
                        "id": "help-grid",
                        "columns": 2,
                        "gap": "sm",
                        "$children": [
                          {
                            "$comp": "Button",
                            "id": "contact-support",
                            "label": "Contact support",
                            "variant": "secondary"
                          },
                          {
                            "$comp": "Button",
                            "id": "read-documentation",
                            "label": "Read documentation",
                            "variant": "quiet"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "$comp": "Tabs",
            "id": "account-tabs",
            "label": "Account sections",
            "tabs": [
              { "id": "summary", "label": "Summary" },
              { "disabled": true, "id": "billing", "label": "Billing" },
              { "id": "activity", "label": "Activity" }
            ],
            "testId": "account-tabs",
            "value": "summary",
            "$children": [
              {
                "$comp": "Text",
                "content": "Account summary remains mounted while another panel is selected.",
                "id": "summary-panel"
              },
              {
                "$comp": "Text",
                "content": "Billing is currently unavailable.",
                "id": "billing-panel"
              },
              {
                "$comp": "Text",
                "content": "Recent account activity.",
                "id": "activity-panel"
              }
            ]
          },
          {
            "$comp": "MenuButton",
            "disabled": false,
            "id": "account-actions",
            "items": [
              { "label": "Edit account", "value": "edit" },
              { "disabled": true, "label": "Delete account", "value": "delete" },
              { "label": "Archive account", "value": "archive" }
            ],
            "label": "Account actions",
            "testId": "account-actions"
          }
        ]
      },
      "exports": {
        "form": {
          "kind": "event",
          "localId": "form",
          "eventType": "org.unifold.ui.form.submitted.v1"
        },
        "name": { "kind": "selection", "localId": "name", "selection": "control-value" },
        "setName": {
          "kind": "command",
          "localId": "name",
          "commandType": "control.set-value"
        }
      }
    }
  ],
  "semantics": {
    "contractVersion": "1.0.0",
    "vocabulary": { "uri": "https://schema.org", "release": "30.0" },
    "primaryEntity": "urn:unifold:person:current",
    "entities": [
      {
        "id": "urn:unifold:person:current",
        "type": "Person",
        "properties": {
          "name": {
            "kind": "composition-export-control-value",
            "instanceId": "profile-editor",
            "exportName": "name"
          }
        }
      }
    ],
    "publication": { "mode": "public-page", "profile": "schema.org" }
  },
  "view": {
    "$compose": "ProfileEditor",
    "$version": "1.0.0",
    "id": "profile-editor",
    "parameters": { "fieldLabel": "Your name" },
    "slots": {
      "actions": [
        {
          "$comp": "Button",
          "id": "submit",
          "action": "submit",
          "label": "Create greeting",
          "testId": "submit"
        },
        {
          "$comp": "Button",
          "id": "reset",
          "action": "reset",
          "label": "Reset profile",
          "testId": "reset",
          "variant": "secondary"
        }
      ]
    }
  }
}
